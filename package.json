{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "description": "Production system of record for AI film: plan, money, provenance.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slate": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/surfaces/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:registry && pnpm test",
    "gate:1": "tsx scripts/gates.ts 1",
    "build:web": "vite build",
    "serve": "tsx src/surfaces/cli.ts serve",
    "gate:2": "tsx scripts/gates.ts 2",
    "docs:registry": "tsx scripts/registry-doc.ts",
    "check:registry": "tsx scripts/registry-doc.ts --check",
    "gate:3": "tsx scripts/gates.ts 3",
    "gate:4": "tsx scripts/gates.ts 4",
    "gate:5": "tsx scripts/gates.ts 5",
    "gate:6": "tsx scripts/gates.ts 6",
    "gate:7": "tsx scripts/gates.ts 7",
    "gate:8": "tsx scripts/gates.ts 8",
    "gate:9": "tsx scripts/gates.ts 9",
    "gate:10": "tsx scripts/gates.ts 10",
    "gate:11": "tsx scripts/gates.ts 11",
    "gate:12": "tsx scripts/gates.ts 12",
    "gate:13": "tsx scripts/gates.ts 13",
    "gate:14": "tsx scripts/gates.ts 14",
    "gate:15": "tsx scripts/gates.ts 15",
    "gate:16": "tsx scripts/gates.ts 16",
    "gate:17": "tsx scripts/gates.ts 17",
    "gate:18": "tsx scripts/gates.ts 18",
    "gate:19": "tsx scripts/gates.ts 19",
    "gate:20": "tsx scripts/gates.ts 20",
    "gate:21": "tsx scripts/gates.ts 21",
    "gate:22": "tsx scripts/gates.ts 22",
    "gate:23": "tsx scripts/gates.ts 23",
    "gate:24": "tsx scripts/gates.ts 24"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^13.1.0",
    "hono": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.65.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.6",
    "vitest": "^2.1.8"
  }
